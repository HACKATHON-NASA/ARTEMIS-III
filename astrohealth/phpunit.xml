<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <!-- Las pruebas unitarias viven en cada módulo (app/Modules/*/Tests/Unit). -->
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Modules">
            <directory suffix="Test.php">app/Modules</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- MySQL de XAMPP (MariaDB 10.4), base SEPARADA: las pruebas la vacían en cada corrida -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_DATABASE" value="astrohealth_testing" force="true"/>
        <env name="DB_URL" value=""/>
        <!-- Secretos SOLO de prueba (no sirven fuera de la suite) -->
        <env name="JWT_SECRET" value="base64:MW8QV3YTq3B+GleuB2urIFLRw5Yuf3CZ5441daWn5fM=" force="true"/>
        <env name="SIMULADOR_CLIENT_ID" value="sim-test" force="true"/>
        <env name="SIMULADOR_CLIENT_SECRET" value="secreto-de-prueba-del-simulador-0123456789abcdef" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
