# Secretos
.env
!.env.example

# Entorno virtual y Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Datos generados (se conserva la estructura con .gitkeep)
data/donki/cache/*
!data/donki/cache/.gitkeep
data/output/*
!data/output/.gitkeep

# Los datos de OSDR (públicos de la NASA, ~85 KB) SÍ se suben: el servidor
# (Render) los necesita para la calibración y no los descarga al arrancar.
