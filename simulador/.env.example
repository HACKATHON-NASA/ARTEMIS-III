# Copie este archivo como .env y ponga su key. El .env NUNCA se sube.
NASA_API_KEY=pon_aqui_tu_key
DONKI_BASE_URL=https://api.nasa.gov/DONKI
# Respaldo opcional; vacío = desactivado. Ejemplo: https://kauai.ccmc.gsfc.nasa.gov/DONKI/WS/get
DONKI_FALLBACK_URL=
OSDR_BASE_URL=https://osdr.nasa.gov
CACHE_TTL_MINUTES=30
HTTP_TIMEOUT_SECONDS=15
HTTP_CONNECT_TIMEOUT_SECONDS=4

API_HOST=0.0.0.0
API_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Opcional: exportar directo a la BD de Laravel
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=astrohealth
DB_USERNAME=root
DB_PASSWORD=
